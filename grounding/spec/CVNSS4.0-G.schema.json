{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xulytiengviet.github.io/Semantic-to-Skill-Compiler-S2SC-/grounding/spec/CVNSS4.0-G.schema.json",
  "title": "S2SC CVNSS4.0-G Evidence Envelope v1.1 (candidate input)",
  "description": "An evidence obligation carrier, not a CVNSS4.0 encoding change. Status must be computed, never supplied.",
  "type": "object",
  "required": ["profile", "value", "role", "evidence"],
  "properties": {
    "profile": { "const": "CVNSS4.0-G/1.1" },
    "value": { "type": "string", "minLength": 1 },
    "role": { "enum": ["FUNCTION", "NOUN", "ADJECTIVE", "IMPERATIVE_VERB", "NUMERIC", "DEICTIC"] },
    "evidence": {
      "type": "object", "minProperties": 1,
      "required": ["acoustic"],
      "properties": {
        "acoustic": { "$ref": "#/$defs/temporal" },
        "referential": { "$ref": "#/$defs/temporal" },
        "attribute": { "type": "object", "required": ["objectId", "key", "value"] },
        "action": { "$ref": "#/$defs/temporal" },
        "numeric": { "$ref": "#/$defs/temporal" },
        "roundtrip": { "type": "object", "description": "Offline audit only; not an online admission obligation" }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    { "if": { "properties": { "role": { "enum": ["NOUN", "ADJECTIVE"] } } },
      "then": { "properties": { "evidence": { "required": ["referential"] } } } },
    { "if": { "properties": { "role": { "const": "ADJECTIVE" } } },
      "then": { "properties": { "evidence": { "required": ["attribute"] } } } },
    { "if": { "properties": { "role": { "const": "IMPERATIVE_VERB" } } },
      "then": { "properties": { "evidence": { "required": ["action"] } } } },
    { "if": { "properties": { "role": { "const": "NUMERIC" } } },
      "then": { "properties": { "evidence": { "required": ["numeric"] } } } }
  ],
  "$defs": {
    "temporal": {
      "type": "object",
      "required": ["observedAtMs", "expiresAtMs"],
      "properties": {
        "observedAtMs": { "type": "number" },
        "expiresAtMs": { "type": "number" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
